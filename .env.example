DATABASE_URL=postgres://rift:rift@127.0.0.1:5432/rift
RIFT_MASTER_KEY=replace-with-32-byte-minimum-master-key
RIFT_JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----
RIFT_JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----
RIFT_INTERNAL_API_TOKEN=replace-with-long-random-internal-token
RIFT_API_BIND=0.0.0.0
RIFT_API_PORT=3001
RIFT_PROXY_BIND=0.0.0.0
RIFT_PROXY_PORT=8080
RIFT_BASE_DOMAIN=localhost
RIFT_PROXY_SCHEME=http
RIFT_ACCESS_TOKEN_TTL_MINUTES=15
RIFT_REFRESH_TOKEN_TTL_DAYS=7
RIFT_COOKIE_SECURE=false
RIFT_CORS_ORIGIN=http://localhost:3000
RIFT_ENGINE_URL=http://127.0.0.1:3001
RIFT_BUILD_ROOT=/tmp/rift/builds
RIFT_DEPLOY_ROOT=/tmp/rift/deployments
# Optional: override auto-detected public IP
# RIFT_PUBLIC_IP=
